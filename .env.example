# =============================================================================
# ropoductions-web — Environment Variables Configuration
# =============================================================================
# Copy this file to:
#   1. .env.local  -> For local Next.js development (`npm run dev`)
#   2. .dev.vars   -> For Cloudflare Workers / Wrangler local development (`npx wrangler dev`)
#
# NEVER commit .env, .env.local, or .dev.vars containing real credentials!
# =============================================================================

# -----------------------------------------------------------------------------
# Studio Administrator Access (Initial Bootstrap)
# -----------------------------------------------------------------------------
# Comma-separated list of numeric Patreon User IDs granted initial Studio Admin
# access passes. Users with these IDs bypass pledge paywalls and gain access to
# the /play route and the internal studio dashboard (/admin).
#
# To seed these IDs into local D1 SQLite directly:
#   npm run db:seed:admins
#
INITIAL_ADMIN_PATREON_IDS=12345678,98765432

# -----------------------------------------------------------------------------
# Patreon API v2 & OAuth 2.0 Credentials
# -----------------------------------------------------------------------------
# Register an OAuth client at: https://www.patreon.com/portal/registration/register-clients
# Redirect URI should be: http://localhost:3000/api/auth/callback (or production domain)
PATREON_CLIENT_ID=your_patreon_client_id
PATREON_CLIENT_SECRET=your_patreon_client_secret
PATREON_REDIRECT_URI=http://localhost:3000/api/auth/callback
PATREON_CAMPAIGN_ID=your_patreon_campaign_id

# -----------------------------------------------------------------------------
# Cryptographic Secrets
# -----------------------------------------------------------------------------
# SESSION_SECRET: Minimum 32 characters used for HMAC-SHA256 cookie signing
SESSION_SECRET=dev_session_secret_change_me_to_at_least_32_chars_in_prod

# TOKEN_ENCRYPTION_KEY: 32-byte key (64 hex characters or 32+ ASCII chars) for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY=dev_token_encryption_key_32_bytes_minimum_length!!

# -----------------------------------------------------------------------------
# Cloudflare API (Optional for local dev; required for remote D1/R2 deployment)
# -----------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
